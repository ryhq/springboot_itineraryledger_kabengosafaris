            {"path": "totalNights", "type": "Integer", "description": "Total number of nights"},
            {"path": "isDayTrip", "type": "Boolean", "description": "Whether this is a single-day trip"},
            {"path": "carCount", "type": "Integer", "description": "Number of vehicles needed"},
            {"path": "description", "type": "String", "description": "Full itinerary description"},
            {"path": "highlights", "type": "String", "description": "Key highlights"},
            {"path": "startLocation", "type": "String", "description": "Starting location"},
            {"path": "endLocation", "type": "String", "description": "Ending location"},
            {"path": "isActive", "type": "Boolean", "description": "Whether itinerary is active"},
            {"path": "totalPaxCount", "type": "Integer", "description": "Total passenger count"},
            {"path": "totalDaysCount", "type": "Integer", "description": "Total days count"},
            {"path": "createdAt", "type": "LocalDateTime", "description": "Creation timestamp"},
            {"path": "updatedAt", "type": "LocalDateTime", "description": "Last update timestamp"}
        ]
    },
