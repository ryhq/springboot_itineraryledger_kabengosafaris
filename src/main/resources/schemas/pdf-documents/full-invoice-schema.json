        "type": "List<PriceDTO>",
        "description": "Grand totals by currency (subtotal + taxes - discounts). Access with: th:each='grandTotal : ${invoice.grandTotals}'",
        "isRequired": false,
        "children": [
            {"path": "currency", "type": "String", "description": "Currency code"},
            {"path": "totalPrice", "type": "BigDecimal", "description": "Grand total amount"},
            {"path": "formattedTotalPrice", "type": "String", "description": "Formatted grand total"}
        ]
    },
    {
        "path": "amountsPaid",
        "type": "List<PriceDTO>",
        "description": "Amounts paid by currency. Access with: th:each='amountPaid : ${invoice.amountsPaid}'",
        "isRequired": false,
        "children": [
            {"path": "currency", "type": "String", "description": "Currency code"},
            {"path": "totalPrice", "type": "BigDecimal", "description": "Amount paid"},
            {"path": "formattedTotalPrice", "type": "String", "description": "Formatted amount paid"}
        ]
    },
    {
        "path": "balances",
        "type": "List<PriceDTO>",
        "description": "Outstanding balances by currency (grandTotal - amountPaid). Access with: th:each='balance : ${invoice.balances}'",
        "isRequired": false,
        "children": [
            {"path": "currency", "type": "String", "description": "Currency code"},
            {"path": "totalPrice", "type": "BigDecimal", "description": "Balance amount"},
            {"path": "formattedTotalPrice", "type": "String", "description": "Formatted balance amount"}
        ]
    },
    {
        "path": "bankAccounts",
        "type": "List<BankAccountDTO>",
        "description": "Active bank accounts for payment (matching invoice currencies). Access with: th:each='bankAccount : ${invoice.bankAccounts}'",
        "isRequired": false,
        "children": [
            {"path": "accountName", "type": "String", "description": "Display name for the bank account"},
            {"path": "accountHolderName", "type": "String", "description": "Legal name of account holder"},
            {"path": "bankName", "type": "String", "description": "Name of the bank"},
            {"path": "bankBranch", "type": "String", "description": "Bank branch name"},
            {"path": "branchAddress", "type": "String", "description": "Branch physical address"},
            {"path": "branchCity", "type": "String", "description": "Branch city"},
            {"path": "branchCountry", "type": "String", "description": "Branch country"},
            {"path": "accountNumber", "type": "String", "description": "Bank account number"},
            {"path": "currency", "type": "String", "description": "Account currency code (USD, EUR, TZS, etc.)"},
            {"path": "swiftBicCode", "type": "String", "description": "SWIFT/BIC code for international wire transfers"},
            {"path": "iban", "type": "String", "description": "IBAN for European/international transfers"},
            {"path": "routingNumber", "type": "String", "description": "US ACH routing number"},
            {"path": "sortCode", "type": "String", "description": "UK sort code"},
            {"path": "intermediaryBankName", "type": "String", "description": "Intermediary/correspondent bank name"},
            {"path": "intermediarySwiftCode", "type": "String", "description": "Intermediary bank SWIFT code"},
            {"path": "invoiceDisplayNotes", "type": "String", "description": "Customer-facing payment instructions and notes"}
        ]
    }
]
