            {"path": "city", "type": "String", "description": "City"},
            {"path": "state", "type": "String", "description": "State/Province"},
            {"path": "country", "type": "String", "description": "Country"},
            {"path": "postalCode", "type": "String", "description": "Postal/ZIP code"},
            {"path": "fullAddress", "type": "String", "description": "Formatted full address"},
            {"path": "preferredLanguage", "type": "String", "description": "Preferred language code (e.g., 'en', 'fr', 'de')"},
