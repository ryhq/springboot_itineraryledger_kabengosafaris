            {"path": "startLocation", "type": "String", "description": "Starting location"},
            {"path": "endLocation", "type": "String", "description": "Ending location"}
        ]
    },
    {
        "path": "items",
        "type": "List<QuoteItemDTO>",
        "description": "Quote line items. Access with: th:each='item : ${quote.items}'",
        "isRequired": false,
        "children": [
            {"path": "id", "type": "String", "description": "Obfuscated item ID"},
            {"path": "itemType", "type": "Enum", "description": "Item type (ACCOMMODATION, PARK_FEE, ACTIVITY, etc.)"},
            {"path": "itemTypeDisplayName", "type": "String", "description": "Human-readable item type"},
            {"path": "itemName", "type": "String", "description": "Item display name"},
            {"path": "description", "type": "String", "description": "Item description"},
            {"path": "displayOrder", "type": "Integer", "description": "Display sequence number"},
            {"path": "isActive", "type": "Boolean", "description": "Whether item is active"},
            {
                "path": "prices",
                "type": "List<PriceDTO>",
                "description": "Prices in different currencies. Access: th:each='price : ${item.prices}'",
                "children": [
                    {"path": "currency", "type": "String", "description": "Currency code (USD, TZS, etc.)"},
                    {"path": "quantity", "type": "Integer", "description": "Quantity"},
                    {"path": "unitPrice", "type": "BigDecimal", "description": "Unit price"},
                    {"path": "totalPrice", "type": "BigDecimal", "description": "Total price (quantity × unitPrice)"},
                    {"path": "breakdown", "type": "String", "description": "Optional pricing breakdown details"},
                    {"path": "formattedUnitPrice", "type": "String", "description": "Formatted unit price with currency symbol"},
                    {"path": "formattedTotalPrice", "type": "String", "description": "Formatted total price with currency symbol"}
                ]
            }
        ]
    },
