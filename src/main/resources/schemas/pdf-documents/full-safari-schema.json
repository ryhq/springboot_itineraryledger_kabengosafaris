                            {"path": "sortOrder", "type": "Integer", "description": "Display order"},
                            {"path": "durationHours", "type": "BigDecimal", "description": "Planned duration in hours"},
                            {"path": "startTime", "type": "String", "description": "Planned start time"},
                            {"path": "endTime", "type": "String", "description": "Planned end time"},
                            {"path": "notes", "type": "String", "description": "Activity notes"},
