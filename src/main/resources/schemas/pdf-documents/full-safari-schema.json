                            {"path": "wasCompleted", "type": "Boolean", "description": "Whether activity was completed"},
                            {"path": "actualStartTime", "type": "String", "description": "Actual start time"},
                            {"path": "actualEndTime", "type": "String", "description": "Actual end time"},
