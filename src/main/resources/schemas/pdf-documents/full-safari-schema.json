    {
        "path": "itinerary",
        "type": "ItineraryDTO",
        "description": "Source itinerary information (null if created without itinerary or if itinerary was deleted). Access with: ${safari.itinerary.name}, ${safari.itinerary.code}, etc.",
        "isRequired": false,
        "children": [
            {"path": "id", "type": "String", "description": "Obfuscated itinerary ID"},
            {"path": "name", "type": "String", "description": "Itinerary name"},
