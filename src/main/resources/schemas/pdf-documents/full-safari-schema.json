            {"path": "specialRequests", "type": "String", "description": "Special requests from customer"},
            {"path": "interests", "type": "String", "description": "Customer interests and preferences"},
            {"path": "isVip", "type": "Boolean", "description": "Whether customer is marked as VIP"}
