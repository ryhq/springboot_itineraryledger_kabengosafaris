        "children": [
            {"path": "currency", "type": "String", "description": "Currency code"},
            {"path": "totalPrice", "type": "BigDecimal", "description": "Discount amount"},
            {"path": "formattedTotalPrice", "type": "String", "description": "Formatted discount amount"}
        ]
    },
    {
