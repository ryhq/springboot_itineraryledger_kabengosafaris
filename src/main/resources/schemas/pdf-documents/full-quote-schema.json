  {
    "path": "grandTotals",
    "type": "List<PriceDTO>",
    "description": "Grand totals by currency (subtotal + taxes - discounts). Access with: th:each='grandTotal : ${quote.grandTotals}'",
    "isRequired": false,
    "children": [
      {
        "path": "currency",
        "type": "String",
        "description": "Currency code"
      },
      {
        "path": "totalPrice",
        "type": "BigDecimal",
        "description": "Grand total amount"
      },
      {
        "path": "formattedTotalPrice",
        "type": "String",
        "description": "Formatted grand total"
      }
    ]
